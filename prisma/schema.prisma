// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// model Applications removed – consolidated into Applications_with_Outreach

model Applications_With_Outreach {
  id                    Int       @id @default(autoincrement())
  company               String
  linkToJobPosting      String?
  hiringManager         String?
  msgToManager          String?
  recruiter             String?
  msgToRecruiter        String?
  notes                 String?
  status                String    @default("apply")
  dateCreated           DateTime  @default(now())
  dateModified         DateTime?
  userId                String
  user                  User      @relation(fields: [userId], references: [id])
}

model Linkedin_Outreach {
  id                  Int       @id @default(autoincrement())
  name                String
  company             String
  firstMessage        String?
  secondMessage       String?
  linkedInUrl         String?
  notes               String?
  recievedReferral    Boolean   @default(false)
  status              String    @default("prospects")
  dateCreated         DateTime  @default(now())
  dateModified       DateTime?
  userId              String
  user                User      @relation(fields: [userId], references: [id])
}

model In_Person_Events {
  id                    Int       @id @default(autoincrement())
  event                 String
  date                  DateTime
  location              String?
  url                   String?
  notes                 String?
  nameOfPersonSpokenTo  String?
  sentLinkedInRequest   Boolean   @default(false)
  careerFair            Boolean   @default(false)
  followUpMessage       String?
  status                String    @default("plan")
  dateCreated           DateTime  @default(now())
  dateModified         DateTime?
  userId                String
  user                  User      @relation(fields: [userId], references: [id])
}

// model Career_Fairs removed – merged into In_Person_Events

model User {
  id                     String                @id @default(cuid())
  name                   String?
  email                  String?               @unique
  image                  String?
  createdAt              DateTime              @default(now())
  resetStartDate         DateTime              @default(now())
  // applications removed – use applicationsWithOutreach instead
  applicationsWithOutreach Applications_With_Outreach[]
  linkedinOutreach       Linkedin_Outreach[]
  inPersonEvents         In_Person_Events[]
  leetCodeUserName       String?
  openSource             OpenSourceEntry[]
  emailVerified          DateTime?
  accounts               Account[]
  onboardingProgress     Int                   @default(0)
  school                 String?
  major                  String?
  expectedGraduationDate DateTime?
  targetOfferDate         DateTime?
  projectedOfferDate     DateTime?
  monthsToSecureInternship Int?
  commitment             Int?
  appsWithOutreachPerWeek Int?
  linkedinOutreachPerWeek Int?
  inPersonEventsPerMonth Int?
  careerFairsPerYear     Int?
  partnerships           UserPartnership[]
  openSourceStatusChanges OpenSourceStatusChange[]
  lastInactivityWarningSent DateTime?
  inactivityWarningCount    Int       @default(0)
  removedFromResumeBook     Boolean   @default(false)
  monthlyMeeting         StudentMonthlyMeeting?
}

model Partnership {
  id              Int       @id
  name            String
  linkedIn        String?
  company         String?
  role            String?
  activeUserCount Int       @default(0)
  maxUsers        Int       @default(5)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  userPartnerships UserPartnership[]
}

model UserPartnership {
  id              Int         @id @default(autoincrement())
  userId          String
  partnershipId   Int
  status          String      @default("active")  // "active", "completed", "abandoned"
  selections      Json?       // Store multiple choice selections: { "0": "high_quality_question" }
  startedAt       DateTime    @default(now())
  completedAt     DateTime?
  user            User        @relation(fields: [userId], references: [id])
  partnership     Partnership @relation(fields: [partnershipId], references: [id])
}

model OpenSourceEntry {
  id                Int       @id @default(autoincrement())
  partnershipName   String
  criteriaType      String?   // e.g., "issue", "blog_post", "multiple_choice"
  metric            String?
  status          String    @default("plan")
  selectedExtras  Json?     // Array of criteria types: ["receive_feedback", "closer"]
  planFields      Json?     // Definition: [{ type: "URL", text: "Link..." }]
  planResponses   Json?     // Answers for plan phase
  babyStepFields  Json?     // Definition: [{ type: "URL", text: "Find..." }]
  babyStepResponses Json?   // Answers for baby step phase
  proofOfCompletion Json?     // Definition: [{ type: "URL", text: "Link..." }]
  proofResponses    Json?     // Answers for completion phase
  dateCreated     DateTime  @default(now())
  dateModified    DateTime?
  userId          String
  user            User      @relation(fields: [userId], references: [id])
}

// Forward-looking log of Open Source activity (column moves + field edits)
model OpenSourceStatusChange {
  id         Int      @id @default(autoincrement())
  userId     String
  entryId    Int
  cardLabel  String
  eventType  String   @default("column_move") // "column_move" | "field_edit"
  fromStatus String?
  toStatus   String?
  fieldLabel String?
  fieldValue String?  @db.Text
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model VerificationToken {
  id              String   @id @default(cuid())
  identifier      String? 
  email           String?
  token           String?   @unique
  expires         DateTime

  @@unique([identifier, token])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String   @unique
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user              User     @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Instructor {
  id                String   @id @default(cuid())
  username          String   @unique
  password          String
  role              InstructorRole @default(ADMIN)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  googleCalendar    InstructorGoogleCalendar?
  availabilityWindows InstructorAvailabilityWindow[]
  studentMeetings   StudentMonthlyMeeting[]
}

/// Standing monthly 1:1 booked by a student (same weekday + time each month).
model StudentMonthlyMeeting {
  id              String     @id @default(cuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instructorId    String
  instructor      Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  /// `${dayOfWeek}|${localTime}` e.g. "3|10:00"
  weeklyKey       String
  dayOfWeek       Int
  localTime       String
  timezone        String     @default("America/Los_Angeles")
  /// Next / first occurrence start (UTC)
  firstOccurrence DateTime
  googleEventId   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([instructorId, weeklyKey])
}

/// OAuth tokens for writing monthly 1:1s on the instructor's Google Calendar.
model InstructorGoogleCalendar {
  id                 String     @id @default(cuid())
  instructorId       String     @unique
  instructor         Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  googleEmail        String?
  accessTokenEnc     String
  refreshTokenEnc    String
  expiryDate         DateTime?
  scope              String?
  connectedAt        DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

/// Weekly windows when students may book 20-min exclusive monthly 1:1s.
model InstructorAvailabilityWindow {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday (JS Date.getDay())
  dayOfWeek    Int
  /// Local time HH:mm (24h), in `timezone`
  startTime    String
  endTime      String
  timezone     String     @default("America/Los_Angeles")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([instructorId])
}

enum InstructorRole {
  ADMIN
  READ_ONLY
}

